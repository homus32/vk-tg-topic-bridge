# VK
VK_GROUP_TOKEN=vk1.a.invalid_test_token_do_not_use

# Database
DATABASE_URL=sqlite+aiosqlite:///data/vk_topic_bridge.db

# Logging
# INFO keeps lifecycle and outcome events; use DEBUG during manual diagnostics.
LOG_LEVEL=INFO
LOG_LEVEL_LIBS=WARNING
LOG_DIR=logs
LOG_ROTATION="10 MB"
LOG_RETENTION="14 days"
LOG_COMPRESSION=zip
